# Copy this file to `.env.local` and fill in real values. Never commit the
# filled-in copy — only this example file, with placeholders, belongs in git.
#
# Both values below come from Neon (https://neon.tech), from the connection
# details panel of a Neon branch. Every environment gets its own pair:
#   Production  -> Neon `main` branch
#   Preview     -> Neon `staging` branch
#   Local dev   -> Neon `staging` branch (or your own personal Neon branch)
# See SETUP.md for where to paste each one.

# Pooled connection string. Used by the running application for normal queries.
# This is the Neon URL that has `-pooler` in the host name.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection string. Used only by Prisma Migrate, which
# cannot run schema changes through a connection pooler. Same host without
# `-pooler`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Only used once per database, by scripts/create-first-user.mjs, to create the
# first Super Admin account. The owner chooses the password; it is never
# stored anywhere except as a one-way hash in the database. Leave these unset
# in Vercel: the running app does not read them.
FIRST_USER_NAME="Owner Name"
FIRST_USER_EMAIL="owner@example.com"
FIRST_USER_PASSWORD="choose-a-strong-password"

# Email sending (password reset links, invites). Comes from the owner's Resend
# account (resend.com -> API Keys), with getomnirent.com verified there. Set in
# Vercel for Production and Preview. Without it no email is sent; outside
# production the message is printed to the server log instead.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional sender. Defaults to "Omnirent <no-reply@getomnirent.com>".
EMAIL_FROM="Omnirent <no-reply@getomnirent.com>"
