# Copy this file to `.env.local` and fill in real values. Never commit the
# filled-in copy — only this example file, with placeholders, belongs in git.
#
# Both values below come from Neon (https://neon.tech), from the connection
# details panel of a Neon branch. Every environment gets its own pair:
#   Production  -> Neon `main` branch
#   Preview     -> Neon `staging` branch
#   Local dev   -> Neon `staging` branch (or your own personal Neon branch)
# See SETUP.md for where to paste each one.

# Pooled connection string. Used by the running application for normal queries.
# This is the Neon URL that has `-pooler` in the host name.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct (non-pooled) connection string. Used only by Prisma Migrate, which
# cannot run schema changes through a connection pooler. Same host without
# `-pooler`.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Only used once per database, by scripts/create-first-user.mjs, to create the
# first Super Admin account. The owner chooses the password; it is never
# stored anywhere except as a one-way hash in the database. Leave these unset
# in Vercel: the running app does not read them.
FIRST_USER_NAME="Owner Name"
FIRST_USER_EMAIL="owner@example.com"
FIRST_USER_PASSWORD="choose-a-strong-password"

# Email sending (password reset links, invites). Comes from the owner's Resend
# account (resend.com -> API Keys), with getomnirent.com verified there. Set in
# Vercel for Production and Preview. Without it no email is sent; outside
# production the message is printed to the server log instead.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Optional sender. Defaults to "Omnirent <no-reply@getomnirent.com>".
EMAIL_FROM="Omnirent <no-reply@getomnirent.com>"

# The Omnirent team's WhatsApp number for brokers, e.g. "+20 100 000 1234".
# Shown in the broker invite email and on the "invite link expired" screen.
# The owner chooses it; set in Vercel for Production and Preview. Without it
# those places leave the number out.
SUPPORT_WHATSAPP="+20 100 000 0000"

# Channex, which passes properties, prices and bookings to Airbnb, Booking.com
# and the other channels. The key comes from the owner's Channex account
# (Organization -> API keys) and is set by the owner in Vercel, never in chat
# or in git. Today only the staging key exists, set for Preview and
# Development; production waits for Channex's certification. Without a key,
# "Save and publish" stays switched off.
CHANNEX_API_KEY="channex-api-key"

# Optional. Which Channex server to use. Defaults to staging
# (https://staging.channex.io/api/v1); production will be
# https://app.channex.io/api/v1, set together with the production key.
CHANNEX_API_URL="https://staging.channex.io/api/v1"

# Secret shared with Channex for the booking webhook
# (/api/channex/webhook). We register the webhook with this value as the
# x-omnirent-webhook-secret header and refuse calls without it. Any long
# random string (e.g. `openssl rand -hex 32`), different per environment.
CHANNEX_WEBHOOK_SECRET="long-random-string"

# Optional. Where Channels requests for the Omnirent team go (turn on
# Google, change a currency, "Need help?"). Defaults to info@getomnirent.com.
CHANNELS_TEAM_EMAIL="team@example.com"
