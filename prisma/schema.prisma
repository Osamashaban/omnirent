// ---------------------------------------------------------------------------
// OmniRent database schema
//
// This file is the single description of what the database looks like. Nothing
// changes the real database except a migration file generated from this file
// (see prisma/migrations/). Editing this file alone changes nothing until a
// migration is created and applied.
//
// Rule of thumb for reading it: `model` = one table, each line inside a model
// = one column, and `@` markers are rules about that column.
// ---------------------------------------------------------------------------

// Where Prisma writes the generated database client the application code uses.
generator client {
  provider = "prisma-client-js"
}

// Which database we talk to, and how.
datasource db {
  provider = "postgresql"

  // The everyday connection, shared through Neon's connection pooler. This is
  // what the running application uses to read and write data.
  url = env("DATABASE_URL")

  // A direct, non-pooled connection to the same database. Neon requires this
  // for schema migrations, because a pooler cannot safely run the kind of
  // statements that change table structure.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Who can sign in to the Ops dashboard, and what each of them is allowed to use.
//
// Every person who signs in is a User. Every User has exactly one Role. What a
// Role may use is decided module by module: Module is the list of every part
// of the system, and RoleModule records "this role may use this module". A
// role can use exactly the modules it has rows for, and nothing else.
//
// Every role works the same way, Super Admin included. Super Admin simply has
// a row for every module: each migration that adds a module also grants it to
// Super Admin (a test enforces this).
// ---------------------------------------------------------------------------

enum UserStatus {
  INVITED // added by an admin, has not set a password yet
  ACTIVE
  DEACTIVATED // cannot sign in; data kept; can be reactivated
}

model User {
  id   String @id @default(cuid())
  name String

  // Always stored in lower case, so "Info@…" and "info@…" are the same person.
  email String @unique

  // Never the password itself: a one-way scrambled form of it (see
  // lib/password.ts). Empty until an invited user accepts their invite.
  passwordHash String?

  status UserStatus @default(INVITED)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  lastLoginAt DateTime?

  // Lockout after repeated wrong passwords (see lib/login-rules.ts).
  failedLoginCount  Int       @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?

  invitedAt   DateTime?
  invitedById String?
  invitedBy   User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invited     User[]    @relation("InvitedBy")

  brokersInvited Broker[] @relation("BrokerInvitedBy")

  sessions Session[]
  tokens   PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id String @id @default(cuid())

  // Typed by whoever creates the role, in whichever language they use.
  name String @unique

  users   User[]
  modules RoleModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id String @id @default(cuid())

  // Stable identifier the code checks against, e.g. "users_roles". Never renamed.
  key String @unique

  // One name per module (Ossama, 2026-10-07). Built-in modules are shown in
  // the viewer's language from lib/i18n.ts by key; this name is the fallback.
  name        String
  description String?

  // Order in lists and the role editor.
  sortOrder Int @default(0)

  roles RoleModule[]

  createdAt DateTime @default(now())
}

// One row = one role may use one module. No row = no access.
model RoleModule {
  roleId   String
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, moduleId])
}

// One row per signed-in browser. The cookie holds a random value; only its
// hash is stored here, so a copy of this table cannot be used to sign in.
// Deleting a user's rows signs them out everywhere.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TokenType {
  RESET // "forgot password" link, valid 60 minutes
  INVITE // invite link, valid 7 days
}

// Single-use links sent by email. Only the hash of the link's secret is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  requestIp String?
  userAgent String?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Settings › Countries & cities.
//
// The places brokers pick from when they add a property. Brokers only see a
// country and city when both are visible. The country also sets the
// property's default currency and time zone. A new country starts hidden, so
// the team can add its cities before brokers see it.
// ---------------------------------------------------------------------------

model Country {
  id     String @id @default(cuid())
  nameAr String @unique
  nameEn String @unique

  // ISO 3166 two-letter code, always upper case, e.g. "EG".
  iso2     String  @unique
  dialCode String // e.g. "+20"
  currency String // ISO 4217 code, e.g. "EGP"
  timezone String // IANA time zone, e.g. "Africa/Cairo"
  visible  Boolean @default(false)

  cities     City[]
  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Restrict)
  nameAr    String
  nameEn    String
  visible   Boolean @default(true)

  brokers    Broker[]
  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryId, nameAr])
  @@unique([countryId, nameEn])
}

// ---------------------------------------------------------------------------
// Settings › Property types.
//
// The names the team picks when adding a property ("Duplex", "Chalet"...).
// Each one is linked to exactly one of Channex's 19 property types, which is
// the only value sent to Channex (see lib/channex-catalog.ts). Many Omnirent
// types can share one Channex type, so new names never clash with Channex.
// ---------------------------------------------------------------------------

enum PropertyTypeGroup {
  APARTMENTS // shown to brokers when adding a property
  HOTELS // not shown to brokers yet; kept for the channel integration
}

enum RentMode {
  WHOLE
  ROOMS
  BOTH
}

enum PropertyTypeStatus {
  ACTIVE // shown when adding a property
  HIDDEN // switched off, not archived
  ARCHIVED // gone from lists; can be restored
}

model PropertyType {
  id          String             @id @default(cuid())
  nameAr      String             @unique
  nameEn      String             @unique
  group       PropertyTypeGroup  @default(APARTMENTS)
  channexType String
  rentMode    RentMode           @default(WHOLE)
  status      PropertyTypeStatus @default(ACTIVE)

  // What the type is called on each channel, keyed by channel id. Only names
  // the team changed from the suggestion are stored; the rest are suggested
  // from the Channex type (lib/channex-catalog.ts).
  channelNames Json @default("{}")

  sortOrder Int @default(0)

  properties Property[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Brokers: the companies that list their properties on Omnirent, and the
// people who sign in to the broker dashboard (app.getomnirent.com) for them.
//
// Brokers never sign up themselves. Ops adds a broker after the intro call
// (Ops › Brokers), which creates the company and its first person, and emails
// that person a link to set their password.
//
// Brokers are kept apart from Ops users on purpose: their own sessions,
// tokens and cookie, so a broker can never reach an Ops page and an Ops
// session never counts as a broker.
// ---------------------------------------------------------------------------

enum BrokerStatus {
  ACTIVE
  DEACTIVATED // nobody at the company can sign in; data kept; can be reactivated
}

enum BrokerUserStatus {
  INVITED // has not set a password yet ("Invite expired" once the link runs out)
  ACTIVE
  DEACTIVATED
}

model Broker {
  id          String       @id @default(cuid())
  companyName String
  mainCityId  String
  mainCity    City         @relation(fields: [mainCityId], references: [id], onDelete: Restrict)
  approxUnits Int?
  // From the intro call. Ops only: never shown to the broker.
  notes       String?
  status      BrokerStatus @default(ACTIVE)

  invitedById   String?
  invitedBy     User?     @relation("BrokerInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  deactivatedAt DateTime?

  // The company's group in Channex, made on its first publish. Its
  // properties go in it.
  channexGroupId String?

  users           BrokerUser[]
  properties      Property[]
  calendarChanges CalendarChange[]
  channelAccounts ChannelAccount[]
  channelBookings ChannelBooking[]
  channelIssues   ChannelIssue[]
  channelNotices  ChannelNotice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BrokerUser {
  id       String @id @default(cuid())
  brokerId String
  broker   Broker @relation(fields: [brokerId], references: [id], onDelete: Restrict)
  name     String

  // Always stored in lower case. What the broker signs in with.
  email String @unique

  // E.164, e.g. "+201005552841".
  mobile String

  // Never the password itself (see lib/password.ts). Empty until the invite
  // is accepted.
  passwordHash String?

  status BrokerUserStatus @default(INVITED)

  invitedAt   DateTime?
  activatedAt DateTime?
  lastLoginAt DateTime?

  sessions          BrokerSession[]
  tokens            BrokerToken[]
  propertiesCreated Property[]
  calendarEdits     CalendarDay[]
  calendarChanges   CalendarChange[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerId])
}

// One row per signed-in browser, like Session for Ops users.
model BrokerSession {
  id           String     @id @default(cuid())
  tokenHash    String     @unique
  brokerUserId String
  brokerUser   BrokerUser @relation(fields: [brokerUserId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  userAgent    String?
  createdAt    DateTime   @default(now())

  @@index([brokerUserId])
}

// Single-use email links for brokers: invite (7 days) and reset (60 minutes).
model BrokerToken {
  id           String     @id @default(cuid())
  type         TokenType
  brokerUserId String
  brokerUser   BrokerUser @relation(fields: [brokerUserId], references: [id], onDelete: Cascade)
  tokenHash    String     @unique
  expiresAt    DateTime
  usedAt       DateTime?
  requestIp    String?
  userAgent    String?
  createdAt    DateTime   @default(now())

  @@index([brokerUserId, type])
}

enum BrokerAuthKind {
  SIGN_IN_FAILED
  SIGN_IN_OK
  RESET_REQUEST
}

// Every broker sign-in attempt and reset request, by email and address. The
// lockout and rate limits count these rows (see lib/broker-rules.ts), so an
// email with no account is treated exactly like one with an account.
model BrokerAuthAttempt {
  id        String         @id @default(cuid())
  kind      BrokerAuthKind
  email     String
  ip        String?
  createdAt DateTime       @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ---------------------------------------------------------------------------
// Properties: what a broker lists, built step by step in the broker app's
// "Add property" wizard (app.getomnirent.com/properties).
//
// A property belongs to one broker company. It is saved as a draft at every
// step, so a broker can stop and come back. Publishing to channels (through
// Channex) comes in a later release; until then every property stays a
// draft. The Channex mapping of each field is in the design notes and in
// lib/property-rules.ts.
//
// Unit types, rates and taxes hang off the property. All prices are in the
// property's currency.
// ---------------------------------------------------------------------------

enum PropertyStatus {
  DRAFT // never published
  SYNCING // being sent to channels
  SYNCED // published
  SYNC_FAILED // the last publish was rejected; the broker fixes it and retries
}

model Property {
  id       String @id @default(cuid())
  brokerId String
  broker   Broker @relation(fields: [brokerId], references: [id], onDelete: Restrict)

  // Step 1: Basics
  propertyTypeId String?
  propertyType   PropertyType? @relation(fields: [propertyTypeId], references: [id], onDelete: Restrict)
  nickname       String // only the broker's team sees it
  titleEn        String        @default("") // shown to guests on channels
  titleAr        String        @default("")
  email          String        @default("")
  phone          String        @default("")
  currency       String        @default("EGP") // ISO 4217

  // Step 2: Location
  countryId  String?
  country    Country? @relation(fields: [countryId], references: [id], onDelete: Restrict)
  cityId     String?
  city       City?    @relation(fields: [cityId], references: [id], onDelete: Restrict)
  compound   String   @default("") // Omnirent only, for search and filters
  address    String   @default("")
  postalCode String   @default("")
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  // Copied from the country when it is picked (IANA, e.g. "Africa/Cairo").
  timezone   String   @default("")

  // Step 3: Units
  rentMode RentMode @default(WHOLE)

  // Step 5: House policies. Option values are listed in lib/property-rules.ts.
  cancellationPolicy String   @default("flexible")
  checkInTime        String   @default("15:00")
  checkOutTime       String   @default("12:00")
  maxGuests          Int?
  adultsOnly         Boolean  @default(false)
  internetType       String   @default("wifi")
  internetCoverage   String   @default("all_rooms")
  internetCost       Decimal? @db.Decimal(12, 2) // empty = free
  parkingType        String   @default("on_site")
  parkingReservation String   @default("not_needed")
  parkingPrivate     Boolean  @default(true)
  petsPolicy         String   @default("not_allowed")
  petFee             Decimal  @default(0) @db.Decimal(12, 2)
  petDeposit         Decimal  @default(0) @db.Decimal(12, 2)
  smokingPolicy      String   @default("no_smoking")

  // Step 7: Listing content. Channels get the English description; the
  // Arabic one stays in Omnirent.
  descriptionEn String   @default("")
  descriptionAr String   @default("")
  importantInfo String   @default("")
  website       String   @default("")
  facilities    String[] @default([])

  // The furthest wizard step the broker has completed (1 to 8), so the
  // wizard reopens where they left off.
  stepsDone Int @default(0)

  status     PropertyStatus @default(DRAFT)
  // Archived properties stay in the list (status "Archived") and keep all data.
  archivedAt DateTime?

  // Channex. Ids are set on the first publish and reused after.
  channexId       String?
  channexPolicyId String?
  // While publishing: the part being sent ("property", "units", "rates",
  // "policy", "content"). After a failed publish: the part that failed.
  syncStage       String?
  // Why the last publish failed: { field?, value?, message? }, shown to the
  // broker in plain words.
  syncError       Json?
  syncStartedAt   DateTime?
  syncedAt        DateTime?

  createdById String?
  createdBy   BrokerUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  unitTypes          UnitType[]
  taxes              PropertyTax[]
  channelConnections ChannelConnection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerId])
  @@index([cityId])
  @@index([propertyTypeId])
}

enum UnitKind {
  UNIT // "Whole unit" mode: a type of identical apartments, sold as one
  ROOM // "Rooms separately" and "Both" modes: one room
  WHOLE // "Both" mode: the whole apartment, whose calendar is linked to its rooms
}

// A unit type (Whole unit mode) or a room (Rooms / Both modes). Becomes a
// Channex room type; `count` is Channex's count_of_rooms ("Identical
// quantity"), always 1 for rooms and the whole apartment.
model UnitType {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind       UnitKind @default(UNIT)
  name       String
  count      Int      @default(1)
  adults     Int      @default(2)
  children   Int      @default(0) // child-only beds
  infants    Int      @default(0) // infant cots
  bedrooms   Int?
  beds       Int      @default(1)
  bathrooms  Int?
  // Rooms only: "private" or "shared".
  bathroom   String?
  sortOrder  Int      @default(0)
  // Channex room type, set on the first publish.
  channexId  String?

  rates        RatePlan[]
  calendar     CalendarDay[]
  channelLinks ChannelLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

// A price for one unit type. The standard rate has no parent; a derived rate
// (e.g. non-refundable, 10% less) points at its standard rate and follows its
// price, minimum stay and closed-to-arrival days.
model RatePlan {
  id         String   @id @default(cuid())
  unitTypeId String
  unitType   UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)
  name       String

  // "per_unit" (Channex per_room) or "per_guest" (per_person).
  sellMode           String  @default("per_unit")
  price              Decimal @default(0) @db.Decimal(12, 2)
  // How many guests the price covers (Channex occupancy).
  guests             Int     @default(1)
  childFee           Decimal @default(0) @db.Decimal(12, 2)
  infantFee          Decimal @default(0) @db.Decimal(12, 2)
  meals              String  @default("none")
  minStay            Int     @default(1) // on arrival
  maxStay            Int     @default(0) // 0 = no limit
  // Empty = same as the property's default cancellation policy.
  cancellationPolicy String  @default("")
  // Weekdays closed to arrival, 1 = Monday ... 7 = Sunday.
  closedToArrival    Int[]   @default([])

  parentId    String?
  parent      RatePlan?  @relation("DerivedRates", fields: [parentId], references: [id], onDelete: Cascade)
  derived     RatePlan[] @relation("DerivedRates")
  // Derived rates only: "decrease_percent" or "decrease_amount", and by how much.
  adjustment  String?
  adjustValue Decimal?   @db.Decimal(12, 2)

  // Channex rate plan, set on the first publish.
  channexId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitTypeId])
}

// A tax or fee added to bookings (Channex Tax, in the property's default tax set).
model PropertyTax {
  id         String    @id @default(cuid())
  propertyId String
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name       String
  kind       String // "tax", "fee" or "city_tax"
  // "per_booking", "percent", "per_night", "per_guest" or "per_guest_per_night".
  logic      String
  amount     Decimal   @db.Decimal(12, 2)
  inclusive  Boolean   @default(false)
  startsOn   DateTime? @db.Date
  endsOn     DateTime? @db.Date
  skipNights Int?
  maxNights  Int?
  sortOrder  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
}

// ---------------------------------------------------------------------------
// Calendar (design App_Calendar): per-night prices, availability and rules.
// ---------------------------------------------------------------------------

// One night of one unit type, only where the broker changed something. An
// empty field means "use the default" from the unit type and its standard
// rate (price, min stay, max stay, closed-to-arrival weekdays). Non-refundable
// and other derived rates follow the standard rate, so they have no rows.
model CalendarDay {
  id         String   @id @default(cuid())
  unitTypeId String
  unitType   UnitType @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date

  price             Decimal? @db.Decimal(12, 2)
  // Units open for sale (at most the unit type's count). Channels get this
  // minus the bookings that night.
  unitsOpen         Int?
  minStay           Int?
  maxStay           Int? // 0 = no limit
  closedToArrival   Boolean?
  closedToDeparture Boolean?
  stopSell          Boolean?
  // Blocked dates are closed on every channel: "owner", "maintenance" or "other".
  blockReason       String?

  updatedById String?
  updatedBy   BrokerUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitTypeId, date])
}

enum CalendarChangeStatus {
  SENDING
  LIVE
  FAILED
}

// One calendar save (quick edit, bulk edit, block, reset or undo), as sent to
// the channels. Drives the "Sending / All changes live / Failed, Retry" pill
// and keeps the Channex values per property so Retry can resend them. The
// change itself is already saved in CalendarDay; `before` holds the rows as
// they were, so the save can be undone for a short while.
model CalendarChange {
  id       String               @id @default(cuid())
  brokerId String
  broker   Broker               @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  status   CalendarChangeStatus @default(SENDING)
  // { [propertyId]: { restrictions: [...], availability: [...] } }, only for
  // properties already on Channex.
  values   Json
  // The CalendarDay rows touched, as they were: [{ unitTypeId, date, row }].
  before   Json
  // { [propertyId]: message } for the properties that failed last time.
  error    Json?
  attempts Int                  @default(0)
  nights   Int                  @default(0)

  createdById String?
  createdBy   BrokerUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  sentAt    DateTime?
  undoneAt  DateTime?

  @@index([brokerId, status])
}

// ---------------------------------------------------------------------------
// Channel connections (design App_Channels, version 80): the broker connects
// booking platforms (Airbnb, Booking.com, Hostelworld and 74 more, all through
// Channex), links each unit type to its listing on each platform and turns
// syncing on. The platform list itself is in lib/channel-catalog.ts; rows here
// exist only for platforms a broker has touched.
//
// Two levels (the design's TWO LEVELS note): Airbnb, VRBO, Google and the
// platforms without a guide connect once for the whole company
// (ChannelAccount.state); Booking.com and every other platform that works with
// a property ID connect property by property (ChannelConnection).
// ---------------------------------------------------------------------------

enum ChannelState {
  WAITING // sent; waiting for the platform (or its support) to reply
  CONNECTED
  ATTENTION // the platform stopped accepting the login or the approval
  REJECTED // the platform declined the property
}

// One per broker company and platform: the account-level connection, when the
// platform has one, and the price on that platform.
model ChannelAccount {
  id       String @id @default(cuid())
  brokerId String
  broker   Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  // The platform's id in lib/channel-catalog.ts, e.g. "abb".
  platform String

  // Empty for property-level platforms and platforms not connected yet.
  state            ChannelState?
  // While WAITING: "confirm", "request" or "unk" (the broker messaged support).
  waitReason       String?
  // What Manage shows for the account: the Airbnb or VRBO login, or the ID
  // the platform's support sent.
  account          String        @default("")
  // The connection settings sent to Channex (IDs, logins), encrypted (see
  // lib/channel-secrets.ts). Never shown again.
  settings         String?
  channexChannelId String?
  // Airbnb approval in progress: the one-time token sent with the Airbnb link.
  oauthToken       String?
  oauthAt          DateTime?

  // Price on this platform: "same", "up" or "down" by pricePct (1 to 50).
  priceMode String @default("same")
  pricePct  Int    @default(0)

  connectedAt DateTime?
  checkedAt   DateTime? // last time a waiting connection was checked again

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brokerId, platform])
}

// A property connected to a property-level platform, with its ID there.
model ChannelConnection {
  id               String       @id @default(cuid())
  brokerId         String
  platform         String
  propertyId       String
  property         Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  state            ChannelState
  // While WAITING: "confirm" (Booking.com accepts the request), "sup" (the
  // broker messaged support, no ID yet) or "cur" (asked to change currency).
  waitReason       String?
  externalId       String       @default("")
  settings         String? // encrypted, as on ChannelAccount
  // Why the platform declined, in its own words.
  rejectReason     String?
  // When the property trades in another currency on the platform.
  currency         String?
  exchangeRate     Decimal?     @db.Decimal(12, 4)
  channexChannelId String?
  connectedAt      DateTime?
  checkedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform, propertyId])
  @@index([brokerId])
}

// A listing (Airbnb) or room (Booking.com and the others) found on a platform
// after connecting. Unit types are linked to these.
model ChannelListing {
  id          String   @id @default(cuid())
  brokerId    String
  platform    String
  // Property-level platforms: the property whose connection found it.
  propertyId  String?
  externalId  String
  name        String
  city        String   @default("")
  guests      Int?
  // The platform's rate plans for this room: [{ id, title, occupancy }].
  rates       Json     @default("[]")
  pricingType String?
  // Removed on the platform since it was found.
  gone        Boolean  @default(false)
  // Unit types the broker said "Not this" to, so they aren't suggested again.
  dismissed   String[] @default([])

  links ChannelLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brokerId, platform, externalId])
}

// A unit type linked to a listing. Unconfirmed links are the suggested
// matches; syncing starts only when the broker turns it on.
model ChannelLink {
  id         String         @id @default(cuid())
  unitTypeId String
  unitType   UnitType       @relation(fields: [unitTypeId], references: [id], onDelete: Cascade)
  platform   String
  listingId  String
  listing    ChannelListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  confirmed  Boolean        @default(true)
  syncOn     Boolean        @default(false)
  // "off", "live" or "failed" (syncing didn't start).
  status     String         @default("off")
  // Why syncing didn't start: { why, fix? } in the platform's words.
  error      Json?
  // Which Omnirent rate each platform rate plan gets: { [rateId]: "std" | "nr" | "none" }.
  ratePlans  Json?
  // Channex mapping ids made for this link (Airbnb).
  mappingIds String[]       @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitTypeId, platform])
  @@index([listingId])
}

// Bookings that came from the platforms (through Channex), kept so upcoming
// stays block unlinking and close the nights everywhere.
model ChannelBooking {
  id               String   @id @default(cuid())
  brokerId         String
  broker           Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  platform         String // catalog id, or "" when the platform isn't in the catalog
  channexBookingId String   @unique
  propertyId       String?
  unitTypeId       String?
  code             String   @default("") // the platform's reservation code
  guest            String   @default("")
  arrival          DateTime @db.Date
  departure        DateTime @db.Date
  // "new", "modified" or "cancelled".
  status           String
  rooms            Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brokerId, departure])
  @@index([unitTypeId, departure])
}

// "Needs your attention": a booking for a room that isn't linked, a price the
// platform rejected, a listing unlisted on the platform, a room deleted there.
model ChannelIssue {
  id          String    @id @default(cuid())
  brokerId    String
  broker      Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  platform    String
  kind        String // "unlinked", "rate", "unlisted" or "roomgone"
  unitTypeId  String?
  data        Json      @default("{}")
  dismissedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([brokerId])
}

// The notifications bell on the Channels page. Text comes from `kind` and
// `params` in the reader's language (lib/channel-i18n.ts).
model ChannelNotice {
  id        String    @id @default(cuid())
  brokerId  String
  broker    Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  platform  String
  kind      String
  params    Json      @default("{}")
  // Where it opens: a platform id, "links" or "issues".
  go        String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([brokerId, createdAt])
}
