// ---------------------------------------------------------------------------
// OmniRent database schema
//
// This file is the single description of what the database looks like. Nothing
// changes the real database except a migration file generated from this file
// (see prisma/migrations/). Editing this file alone changes nothing until a
// migration is created and applied.
//
// Rule of thumb for reading it: `model` = one table, each line inside a model
// = one column, and `@` markers are rules about that column.
// ---------------------------------------------------------------------------

// Where Prisma writes the generated database client the application code uses.
generator client {
  provider = "prisma-client-js"
}

// Which database we talk to, and how.
datasource db {
  provider = "postgresql"

  // The everyday connection, shared through Neon's connection pooler. This is
  // what the running application uses to read and write data.
  url = env("DATABASE_URL")

  // A direct, non-pooled connection to the same database. Neon requires this
  // for schema migrations, because a pooler cannot safely run the kind of
  // statements that change table structure.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Who can sign in, and what each of them is allowed to use.
//
// Every person who signs in is a User. Every User has exactly one Role. What a
// Role may use is decided feature by feature: Feature is the list of every
// part of the system, and RoleFeature records "this role may use this feature".
// A role can use exactly the features it has rows for, and nothing else.
//
// Every role works the same way, Super Admin included. Super Admin simply has
// a row for every feature: each migration that adds a feature also grants it
// to Super Admin (a test enforces this).
// ---------------------------------------------------------------------------

model User {
  id String @id @default(cuid())

  // Always stored in lower case, so "Info@…" and "info@…" are the same person.
  email String @unique

  // Never the password itself: a one-way scrambled form of it (see
  // lib/password.ts). Nobody, including us, can read a password back out.
  passwordHash String

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id   String @id @default(cuid())
  name String @unique

  users    User[]
  features RoleFeature[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Feature {
  id String @id @default(cuid())

  // Stable identifier the code checks against, e.g. "users". Never renamed.
  key String @unique

  // What people see in the roles screen.
  name        String
  description String?

  roles RoleFeature[]

  createdAt DateTime @default(now())
}

// One row = one role may use one feature. No row = no access.
model RoleFeature {
  roleId    String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  featureId String
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, featureId])
}
